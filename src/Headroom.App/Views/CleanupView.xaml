<UserControl x:Class="Headroom.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Headroom.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupViewModel}">
    <DockPanel Margin="4,0,4,8">
        <!-- Cabeçalho e barra de ações -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Limpeza" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding RulesInfo}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,10" />

            <ui:InfoBar Title="Sem privilégios de administrador" IsOpen="True" IsClosable="True" Severity="Warning" Margin="0,0,0,8"
                        Message="Limpezas marcadas com o escudo precisam de administrador: sem elevação, itens protegidos são pulados e ações do sistema ficam indisponíveis."
                        Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />
            <ui:InfoBar Title="Regras JSON" Message="{Binding LoadWarnings}" IsOpen="True" IsClosable="True" Severity="Warning" Margin="0,0,0,8"
                        Visibility="{Binding LoadWarnings, Converter={StaticResource NullToVis}}" />

            <WrapPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Perfil" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="190"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.Name="Perfil de limpeza">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ui:Button Content="Analisar" Icon="{ui:SymbolIcon Search24}" Command="{Binding AnalyzeCommand}" Margin="0,0,8,8" />
                <ui:Button Content="Limpar" Icon="{ui:SymbolIcon Broom24}" Appearance="Primary" Command="{Binding CleanCommand}" Margin="0,0,8,8" />
                <ui:Button Content="Cancelar" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}" Margin="0,0,16,8"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Recarregar regras" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" Margin="0,0,16,8"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                <ui:ToggleSwitch Content="Excluir permanentemente (sem Lixeira)" IsChecked="{Binding UsePermanentDeletion}" Margin="0,0,16,8"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                <ui:ToggleSwitch Content="Ponto de restauração antes de itens avançados" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,8"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            </WrapPanel>

            <TextBlock Text="{Binding TotalText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" />

            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="1" Height="6" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Resumo final -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                        <ui:Button Content="Abrir log" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                        <ui:Button Content="Esvaziar a Lixeira" Icon="{ui:SymbolIcon Delete24}" Command="{Binding EmptyRecycleBinCommand}" HorizontalAlignment="Stretch"
                                   Visibility="{Binding SummaryHasRecycleBin, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="22" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SummaryHeadline}" Style="{StaticResource SectionTitle}" Margin="0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SummaryLines}" Margin="30,6,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SummaryLine}">
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SummaryDetails}" Style="{StaticResource Caption}" Margin="30,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Regras por categoria -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CleanupCategoryViewModel}">
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="Marcar todas" Appearance="Transparent" Padding="8,2" Command="{Binding CheckAllCommand}" />
                                            <ui:Button Content="Desmarcar" Appearance="Transparent" Padding="8,2" Command="{Binding UncheckAllCommand}" />
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                                            <Run Text="   " />
                                            <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CleanupRuleViewModel}">
                                            <Border Padding="8,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                              AutomationProperties.Name="{Binding Name}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlockedByAdmin}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInformational}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                    <StackPanel Grid.Column="1">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Margin="0,0,4,0" />
                                                            <Border Style="{StaticResource Pill}" Background="{Binding RiskBrush}">
                                                                <TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="White" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" ToolTip="Requer administrador"
                                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Shield24" FontSize="11" Margin="0,0,3,0" />
                                                                    <TextBlock Text="Admin" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" ToolTip="Sempre exclui de forma permanente (não usa a Lixeira)"
                                                                    Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Permanente" FontSize="11" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" Visibility="{Binding IsInformational, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Informativo" FontSize="11" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" ToolTip="{Binding SourceText}"
                                                                    Visibility="{Binding IsJsonRule, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="JSON" FontSize="11" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Visibility="{Binding DetailText, Converter={StaticResource NullToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" MinWidth="120" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Right"
                                                                         Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />
                                                        <ui:Button Content="Ver itens" Appearance="Transparent" Padding="6,2" HorizontalAlignment="Right"
                                                                   Command="{Binding ShowItemsCommand}"
                                                                   Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Painel de itens da regra selecionada (prévia) -->
            <Border Grid.Column="1" Width="560" Style="{StaticResource CardBorder}" Padding="12" Margin="4,0,0,0"
                    Visibility="{Binding SelectedRule, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Command="{Binding CloseItemsCommand}"
                                   ToolTip="Fechar" AutomationProperties.Name="Fechar lista de itens" />
                        <TextBlock Text="{Binding SelectedRule.Name}" Style="{StaticResource SectionTitle}" Margin="0" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedRule.DetailText}" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="Marcar todos" Command="{Binding SelectAllItemsCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Desmarcar todos" Command="{Binding SelectNoItemsCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SelectedRule.Items}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                              AutomationProperties.Name="Itens encontrados na análise">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Item" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                        <StackPanel ToolTip="{Binding FullPath}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding Reason, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding Reason, Converter={StaticResource NullToVis}, ConverterParameter=inverse}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="Modificado" Binding="{Binding Modified, Converter={StaticResource Date}, ConverterParameter=d}" Width="95" />
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Transparent" Padding="4" ToolTip="Abrir no Explorer"
                                                   Command="{Binding DataContext.OpenItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" AutomationProperties.Name="Abrir no Explorer" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
