<UserControl x:Class="Headroom.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Headroom.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <!-- Lista editável de pastas: o comando de remover vem por Tag (ViewModel). -->
        <DataTemplate x:Key="FolderItem">
            <DockPanel Margin="0,2">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="4"
                           Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                           ToolTip="Remover" AutomationProperties.Name="Remover pasta" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Width" Value="360" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,24" MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Content="Salvar" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <!-- Aparência -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Aparência e idioma" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Tema" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name" Width="260" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Idioma da interface" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" Width="260" HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Scanner -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Scanner" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Quantos maiores arquivos guardar por scan" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding TopFilesCount}" Minimum="10" Maximum="100000" SmallChange="100" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Tamanho mínimo padrão em &quot;Maiores arquivos&quot; (MB)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding LargeFileMinimumMb}" Minimum="0" Maximum="1000000" SmallChange="10" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Tamanho mínimo para procurar duplicados (MB)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding DuplicateMinimumMb}" Minimum="0" Maximum="100000" SmallChange="1" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Text="Pastas ignoradas pelo scanner" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding ExcludedPaths}" ItemTemplate="{StaticResource FolderItem}" Tag="{Binding RemoveExcludedPathCommand}" />
                    <ui:Button Content="Adicionar pasta…" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddExcludedPathCommand}" Margin="0,4,0,0" />

                    <TextBlock Text="Análises salvas" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <CheckBox IsChecked="{Binding SaveAnalyses}" Content="Guardar cada análise para abrir depois sem escanear de novo" />
                    <CheckBox IsChecked="{Binding OpenLastAnalysisOnStart}" Content="Ao abrir o Headroom, reabrir a última análise" Margin="0,4,0,0"
                              IsEnabled="{Binding SaveAnalyses}" />
                    <TextBlock Text="{Binding SavedAnalysesInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ui:Button Content="Apagar análises salvas" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteSavedAnalysesCommand}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Limpeza -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Limpeza" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Projetos parados: sem modificação há mais de (dias)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding StaleProjectDays}" Minimum="1" Maximum="3650" SmallChange="15" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Downloads antigos: mais de (dias)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding OldDownloadsDays}" Minimum="1" Maximum="3650" SmallChange="15" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Arquivos grandes e antigos: a partir de (MB)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding OldLargeFileMinimumMb}" Minimum="1" Maximum="1000000" SmallChange="50" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Arquivos grandes e antigos: sem modificação há (meses)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding OldLargeFileMonths}" Minimum="1" Maximum="240" SmallChange="1" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Capturas de tela antigas: mais de (dias)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding OldScreenshotsDays}" Minimum="1" Maximum="3650" SmallChange="30" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <ui:ToggleSwitch Content="Criar ponto de restauração antes de limpezas avançadas" IsChecked="{Binding CreateRestorePoint}" Margin="0,8,0,0" />

                    <TextBlock Text="Pastas onde ficam seus projetos (para &quot;Projetos parados&quot;)" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding DevProjectRoots}" ItemTemplate="{StaticResource FolderItem}" Tag="{Binding RemoveDevRootCommand}" />
                    <ui:Button Content="Adicionar pasta…" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddDevRootCommand}" Margin="0,4,0,0" />

                    <TextBlock Text="Pastas para compressão NTFS (regra avançada)" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding CompressionFolders}" ItemTemplate="{StaticResource FolderItem}" Tag="{Binding RemoveCompressionFolderCommand}" />
                    <ui:Button Content="Adicionar pasta…" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddCompressionFolderCommand}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Agendamento e alertas -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Agendamento e alertas" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <ui:ToggleSwitch Content="Limpeza agendada (Agendador de Tarefas do Windows)" IsChecked="{Binding ScheduleEnabled}" />
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ScheduleEnabled}">
                        <TextBlock Text="Frequência" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedFrequency}" DisplayMemberPath="Name" Width="260" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ScheduleEnabled}">
                        <TextBlock Text="Horário (HH:mm)" Style="{StaticResource Label}" />
                        <ui:TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ScheduleEnabled}">
                        <TextBlock Text="Perfil" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ScheduleProfile}" DisplayMemberPath="Name" Width="260" HorizontalAlignment="Left" />
                    </DockPanel>
                    <ui:ToggleSwitch Content="Avisar quando o espaço livre de um disco ficar abaixo do limite" IsChecked="{Binding FreeSpaceAlertEnabled}" Margin="0,8,0,0" />
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding FreeSpaceAlertEnabled}">
                        <TextBlock Text="Limite de espaço livre (%)" Style="{StaticResource Label}" />
                        <ui:NumberBox Value="{Binding FreeSpaceAlertPercent}" Minimum="1" Maximum="50" SmallChange="1" Width="160" HorizontalAlignment="Left" />
                    </DockPanel>
                    <ui:Button Content="Aplicar agendamento" Icon="{ui:SymbolIcon CalendarClock24}" Command="{Binding ApplyScheduleCommand}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ScheduleStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="A limpeza agendada roda: Headroom.exe --profile &lt;perfil&gt; --silent --log --notify. Programas abertos não são fechados: arquivos em uso são pulados." />
                </StackPanel>
            </Border>

            <!-- Pastas do app -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Dados do aplicativo" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <ui:Button Content="Abrir logs" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="Abrir pasta de regras JSON" Icon="{ui:SymbolIcon Code24}" Command="{Binding OpenRulesCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="Abrir pasta de dados" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Regras JSON colocadas na pasta de regras aparecem na tela Limpeza após &quot;Recarregar regras&quot;. Veja exemplos na pasta Rules ao lado do executável." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
