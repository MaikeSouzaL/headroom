<UserControl x:Class="Headroom.App.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Headroom.App.ViewModels"
             xmlns:reg="clr-namespace:Headroom.Core.RegistryCleanup;assembly=Headroom.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RegistryViewModel}">
    <DockPanel Margin="4,0,4,8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Registro" Style="{StaticResource PageTitle}" />
            <ui:InfoBar Title="Ganho mínimo" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
                        Message="Limpar o registro libera pouquíssimo espaço e não deixa o PC perceptivelmente mais rápido. O Headroom só lista itens comprovadamente órfãos (o programa/arquivo referenciado não existe mais) e sempre faz backup .reg antes, com opção de desfazer." />
            <ui:ToggleSwitch Content="Ativar a limpeza de registro (Avançado)" IsChecked="{Binding IsEnabled}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding IsEnabled}">
                <ui:Button Content="Procurar itens órfãos" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Fazer backup e corrigir marcados" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding FixCommand}" />
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Issues}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="None" IsEnabled="{Binding IsEnabled}" EnableRowVirtualization="True"
                      AutomationProperties.Name="Itens órfãos do registro">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RegistryIssueViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Item" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RegistryIssueViewModel}">
                                <StackPanel ToolTip="{Binding Location}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Backups (Desfazer)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="Desfazer" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Abrir pasta do backup" Command="{Binding OpenBackupFolderCommand}"
                                   AutomationProperties.Name="Abrir pasta do backup" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutomationProperties.Name="Backups do registro">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type reg:RegistryBackup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Date, Converter={StaticResource Date}}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding Count, Mode=OneWay}" />
                                        <Run Text="arquivo(s) .reg" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
