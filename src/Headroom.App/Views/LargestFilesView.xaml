<UserControl x:Class="Headroom.App.Views.LargestFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Headroom.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LargestFilesViewModel}">
    <DockPanel Margin="4,0,4,8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Maiores arquivos" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,12">
                <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="·" />
                <Run Text="{Binding CapacityNote, Mode=OneWay}" />
            </TextBlock>

            <!-- Filtros -->
            <WrapPanel Margin="0,0,0,12">
                <ui:TextBox PlaceholderText="Buscar por nome ou pasta…" Width="280" Margin="0,0,12,8"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                            AutomationProperties.Name="Buscar" />
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Width="200" Margin="0,0,12,8"
                          AutomationProperties.Name="Filtrar por categoria" />
                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <TextBlock Text="Mínimo (MB)" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}" />
                    <ui:NumberBox Value="{Binding MinimumSizeMb, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1000000"
                                  SmallChange="10" Width="140" AutomationProperties.Name="Tamanho mínimo em MB" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <TextBlock Text="Sem modificar há mais de (meses)" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}" />
                    <ui:NumberBox Value="{Binding OlderThanMonths, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="600"
                                  SmallChange="1" Width="120" AutomationProperties.Name="Não modificado há mais de X meses" />
                </StackPanel>
                <ui:Button Content="Limpar filtros" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" />
            </WrapPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheckedActionBar}" Focusable="False" Margin="0,0,0,8" />
        </StackPanel>

        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  PreviewKeyDown="OnKeyDown"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ContextMenu="{StaticResource FileContextMenu}"
                  AutomationProperties.Name="Lista dos maiores arquivos">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44" CanUserResize="False" SortMemberPath="IsChecked">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                            <CheckBox Style="{StaticResource RowCheckBox}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Marcar {0} para excluir'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Nome" Width="2*" MinWidth="200" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding CategoryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Pasta" Binding="{Binding Folder}" Width="3*" MinWidth="200" />
                <DataGridTemplateColumn Header="Tamanho" Width="110" SortMemberPath="Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TypeText}" Width="170" />
                <DataGridTextColumn Header="Modificado" Binding="{Binding Modified, Converter={StaticResource Date}}" SortMemberPath="Modified" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
