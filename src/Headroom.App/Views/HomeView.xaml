<UserControl x:Class="Headroom.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Headroom.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,4,24">
            <TextBlock Text="O que você quer escanear?" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Marque um ou mais discos (ou escolha uma pasta). O scan só lê os arquivos — nada é apagado sem a sua confirmação." />

            <!-- Aviso de administrador -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ShieldError24" FontSize="28" Margin="0,0,16,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                    <ui:Button DockPanel.Dock="Right" Content="Reiniciar como administrador" Appearance="Primary"
                               Command="{Binding RestartAsAdminCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="O Headroom está rodando sem privilégios de administrador" FontWeight="SemiBold"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="Algumas pastas do sistema (ex.: System Volume Information, perfis de outros usuários) serão puladas, e o total encontrado pode ficar menor que o usado no disco." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Alerta de pouco espaço -->
            <ui:InfoBar Title="Pouco espaço livre" Message="{Binding LowSpaceWarning}" Severity="Warning"
                        IsOpen="True" IsClosable="True" Margin="0,0,0,12"
                        Visibility="{Binding LowSpaceWarning, Converter={StaticResource NullToVis}}" />

            <DockPanel Margin="0,4,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon CheckmarkCircle24}" Content="Marcar todos" Appearance="Transparent"
                               Command="{Binding SelectAllDrivesCommand}" Margin="0,0,4,0" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Content="Desmarcar" Appearance="Transparent"
                               Command="{Binding ClearDriveSelectionCommand}" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Atualizar discos"
                               Command="{Binding RefreshDrivesCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Discos" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="clique nos cartões para marcar quais analisar" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Drives}" AutomationProperties.Name="Discos disponíveis">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveCardViewModel}">
                        <CheckBox Style="{StaticResource SelectableCard}"
                                  IsChecked="{Binding IsSelected}" Width="320" Margin="0,0,12,12"
                                  AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="32" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding MediaKind}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding FileSystem, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding TotalText, Mode=OneWay}" />
                                            <Run Text="{Binding Model, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <ProgressBar Value="{Binding UsedFraction, Mode=OneWay}" Margin="0,14,0,8">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource UsageBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding SavedText, Converter={StaticResource NullToVis}}">
                                    <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ou escaneie só uma pasta" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Escolher uma pasta…"
                           Command="{Binding ChooseFolderCommand}" />
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="600" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen24}" Content="{Binding OpenSavedButtonText}"
                           Command="{Binding OpenSavedCommand}" Padding="28,10" FontSize="16" Margin="0,0,12,0"
                           Visibility="{Binding HasSavedForAll, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.Name="Abrir análise salva"
                           ToolTip="Abre o resultado guardado na hora, sem escanear o disco de novo" />
                <ui:Button Icon="{ui:SymbolIcon Play24}" Content="{Binding ScanButtonText}"
                           Command="{Binding ScanCommand}" Padding="28,10"
                           FontSize="16" AutomationProperties.Name="Escanear">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Primary" />
                            <Setter Property="IsDefault" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSavedForAll}" Value="True">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Setter Property="IsDefault" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <TextBlock Text="{Binding TargetText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="640" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
